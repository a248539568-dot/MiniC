<local:DesktopBoxWindow x:Class="MiniC.Views.DeskGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniC.Views"
        xmlns:controls="clr-namespace:MiniC.Controls"
        xmlns:viewModels="clr-namespace:MiniC.ViewModels"
        AllowDrop="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        DragEnter="Window_DragOver" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{Binding ContentShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#32FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoxContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{Binding GlassMenuBackground}" />
            <Setter Property="BorderBrush" Value="{Binding GlassMenuBorder}" />
            <Setter Property="Foreground" Value="{Binding PrimaryForeground}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#620B1220" BlurRadius="22" ShadowDepth="6" Opacity="0.42" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoxMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{Binding PrimaryForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinWidth" Value="206" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                    CornerRadius="7" MinHeight="32">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="CheckMark" Visibility="Collapsed" Data="M2,6 L5,9 L11,2"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      RecognizesAccessKey="True" VerticalAlignment="Center" />
                                    <Path x:Name="SubmenuArrow" Grid.Column="2" Visibility="Collapsed"
                                          Data="M4,2 L9,7 L4,12" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right" HorizontalOffset="-3" PopupAnimation="Fade">
                                <Border Background="{Binding GlassMenuBackground}" BorderBrush="{Binding GlassMenuBorder}"
                                        BorderThickness="1" CornerRadius="12" Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#620B1220" BlurRadius="20" ShadowDepth="5" Opacity="0.4" />
                                    </Border.Effect>
                                    <ScrollViewer><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{Binding GlassMenuHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoxMenuSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{Binding GlassMenuBorder}" Opacity="0.55" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="TransparentScrollPageButton" TargetType="RepeatButton">
            <Border Background="Transparent" />
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Template="{StaticResource TransparentScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Border Width="4" CornerRadius="2" Background="#805A6475" />
                                    </ControlTemplate></Thumb.Template></Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Template="{StaticResource TransparentScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="GroupShell" CornerRadius="{Binding Corners}" Background="Transparent"
            BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="GroupMaterial" Grid.RowSpan="3" IsHitTestVisible="False">
                <controls:CrystalGlassSurface x:Name="CrystalBackdrop" UseWallpaper="{Binding UsesWallpaper}" Tint="{Binding GlassBackground}" Radius="{Binding Appearance.Radius}" Strength="{Binding Appearance.RefractionStrength}" Angle="{Binding Appearance.RefractionAngle}" RippleStrength="{Binding Appearance.CrystalRippleStrength}" RippleScale="{Binding Appearance.CrystalRippleScale}" Visibility="{Binding IsCrystal, Converter={StaticResource BooleanToVisibility}}" />
                <controls:FrostedGlassSurface x:Name="FrostedBackdrop" UseWallpaper="{Binding UsesWallpaper}" Tint="{Binding GlassBackground}" Radius="{Binding Appearance.Radius}" BlurRadius="{Binding Appearance.FrostedBlurRadius}" NativeBackdropActive="{Binding ComposedBackdropActive}" Visibility="{Binding IsFrosted, Converter={StaticResource BooleanToVisibility}}" />
                <controls:SolidMaterialSurface x:Name="SolidBackdrop" UseWallpaper="{Binding UsesWallpaper}" Tint="{Binding GlassBackground}" Radius="{Binding Appearance.Radius}" Visibility="{Binding IsSolid, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>

            <Border x:Name="GroupHeader" Grid.Row="0" Background="{Binding HeaderBackground}" CornerRadius="{Binding HeaderCorners}"
                    Cursor="SizeAll"
                    PreviewMouseLeftButtonDown="Header_MouseLeftButtonDown"
                    PreviewMouseMove="Header_MouseMove"
                    PreviewMouseLeftButtonUp="Header_MouseLeftButtonUp"
                    LostMouseCapture="Header_LostMouseCapture">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="GroupTitleArea" Tag="GroupTitle" VerticalAlignment="Center"
                          PreviewMouseLeftButtonDown="GroupTitle_MouseLeftButtonDown">
                        <TextBlock Text="{Binding Name}" Foreground="{Binding PrimaryForeground}" FontSize="14" Effect="{Binding ContentShadow}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="GroupTitleEditor" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="5,2" VerticalContentAlignment="Center"
                                 BorderBrush="#806B9EE8" BorderThickness="1" Background="#EFFFFFFF"
                                 Foreground="#E5222936" CaretBrush="#E5222936" Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibility}}"
                                 PreviewKeyDown="GroupTitleEditor_PreviewKeyDown"
                                 LostKeyboardFocus="GroupTitleEditor_LostKeyboardFocus" />
                    </Grid>
                    <TextBlock x:Name="WidgetTitle" Grid.Column="0" Visibility="Collapsed"
                               Foreground="{Binding PrimaryForeground}" FontSize="14" Effect="{Binding ContentShadow}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border x:Name="GroupItemCounter" Grid.Column="1" MinWidth="28" Height="24" Padding="7,0" Margin="6,0"
                            Background="{Binding CountBackground}" CornerRadius="8">
                        <TextBlock Text="{Binding Items.Count}" Foreground="{Binding CountForeground}"
                                   FontSize="11" VerticalAlignment="Center" TextAlignment="Center" />
                    </Border>
                    <Button x:Name="GroupViewModeButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="切换图标和列表预览"
                            Click="ViewModeButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Stroke="{Binding PrimaryForeground}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M3,4 L5,4 L5,6 L3,6 Z M7,5 L16,5 M3,8 L5,8 L5,10 L3,10 Z M7,9 L16,9 M3,12 L5,12 L5,14 L3,14 Z M7,13 L16,13" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                                <Setter Property="Data" Value="M3,3 L7,3 L7,7 L3,7 Z M11,3 L15,3 L15,7 L11,7 Z M3,11 L7,11 L7,15 L3,15 Z M11,11 L15,11 L15,15 L11,15 Z" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                    </Button>
                    <Button x:Name="GroupCollapseButton" Grid.Column="3" Style="{StaticResource IconButton}" ToolTip="折叠或展开"
                            Click="CollapseButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Stroke="{Binding PrimaryForeground}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="M4,10 L9,5 L14,10" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Data" Value="M4,6 L9,11 L14,6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                    </Button>
                    <Button x:Name="GroupMenuButton" Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="收纳盒菜单"
                            Click="MenuButton_Click">
                        <Viewbox Width="15" Height="15">
                            <Path Data="M4,8 A1.25,1.25 0 1 0 4,10.5 A1.25,1.25 0 1 0 4,8 M10.75,8 A1.25,1.25 0 1 0 10.75,10.5 A1.25,1.25 0 1 0 10.75,8 M17.5,8 A1.25,1.25 0 1 0 17.5,10.5 A1.25,1.25 0 1 0 17.5,8"
                                  Fill="{Binding PrimaryForeground}" />
                        </Viewbox>
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="TabsBar" Grid.Row="1" Height="34" Padding="8,3"
                    Background="#18FFFFFF" Visibility="Collapsed">
                <ItemsControl x:Name="TabsHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><controls:AnimatedUniformGrid /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:BoxTabItem}">
                            <Button Tag="DeskGroupTab" Height="28" Margin="2,0" Padding="8,0"
                                    BorderThickness="0" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="Tab_MouseLeftButtonDown"
                                    PreviewMouseMove="Tab_MouseMove"
                                    PreviewMouseLeftButtonUp="Tab_MouseLeftButtonUp"
                                    LostMouseCapture="Tab_LostMouseCapture">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#14FFFFFF" />
                                        <Setter Property="Foreground" Value="{Binding DataContext.PrimaryForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TabSurface" Property="Background" Value="#30FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.ItemSelectedBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding DataContext.PrimaryForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Effect="{Binding DataContext.ContentShadow, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextAlignment="Center" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ContentControl x:Name="WidgetHost" Grid.Row="2" Panel.ZIndex="2" Margin="12,8,12,12"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Visibility="Collapsed" />

            <ScrollViewer x:Name="ItemsScroller" Grid.Row="2" Margin="12,8,12,12" FocusVisualStyle="{x:Null}"
                          HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="SelectionSurface" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                      PreviewMouseLeftButtonDown="SelectionSurface_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="SelectionSurface_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="SelectionSurface_PreviewMouseLeftButtonUp"
                      PreviewMouseRightButtonUp="SelectionSurface_PreviewMouseRightButtonUp"
                      LostMouseCapture="SelectionSurface_LostMouseCapture">
                    <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value><ItemsPanelTemplate><controls:AnimatedWrapPanel HorizontalAlignment="Left" /></ItemsPanelTemplate></Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DesktopItem}">
                                <Border Tag="DeskItemTile" CornerRadius="5" AllowDrop="True"
                                        PreviewMouseLeftButtonDown="Item_MouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="Item_MouseLeftButtonUp"
                                        PreviewMouseMove="Item_MouseMove"
                                        PreviewMouseRightButtonUp="Item_MouseRightButtonUp"
                                        DragEnter="Item_DragOver" DragOver="Item_DragOver"
                                        DragLeave="Item_DragLeave" Drop="Item_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Width" Value="82" />
                                            <Setter Property="Height" Value="88" />
                                            <Setter Property="Margin" Value="3" />
                                            <Setter Property="Padding" Value="5" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Effect" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding IsItemDragActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{Binding DataContext.ItemHoverBackground, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{Binding DataContext.ItemSelectedBackground, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{Binding DataContext.ItemSelectedBorder, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowFullName}" Value="True">
                                                    <Setter Property="Panel.ZIndex" Value="10" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDragPreviewSource}" Value="True">
                                                    <Setter Property="Opacity" Value="0" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="List">
                                                    <Setter Property="Width" Value="Auto" />
                                                    <Setter Property="Height" Value="48" />
                                                    <Setter Property="MinHeight" Value="48" />
                                                    <Setter Property="Margin" Value="2,2" />
                                                    <Setter Property="Padding" Value="8,4" />
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="Effect" Value="{x:Null}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                            <Image Source="{Binding Icon}" Stretch="Uniform"
                                                   Effect="{Binding DataContext.ContentShadow, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Width" Value="46" />
                                                        <Setter Property="Height" Value="46" />
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCutToClipboard}" Value="True">
                                                                <Setter Property="Opacity" Value="0.5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="List">
                                                                <Setter Property="Width" Value="36" />
                                                                <Setter Property="Height" Value="36" />
                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <Border Width="20" Height="20" CornerRadius="5" Background="#F7FFFFFF"
                                                    BorderBrush="#26000000" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Visibility="{Binding IsCopiedToClipboard, Converter={StaticResource BooleanToVisibility}}">
                                                <Border.Effect><DropShadowEffect Color="#50000000" BlurRadius="3" ShadowDepth="1" Opacity="0.45" /></Border.Effect>
                                                <Viewbox Width="14" Height="14">
                                                    <Path Data="M6,2.5 H11.5 A2,2 0 0 1 13.5,4.5 V10 H11.5 V4.5 H6 Z M4.5,5.5 H10 A2,2 0 0 1 12,7.5 V13.5 H4.5 A2,2 0 0 1 2.5,11.5 V7.5 A2,2 0 0 1 4.5,5.5 Z"
                                                          Stroke="#0F6CBD" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                                </Viewbox>
                                            </Border>
                                            <Border Width="20" Height="20" CornerRadius="5" Background="#F7FFFFFF"
                                                    BorderBrush="#26000000" BorderThickness="1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Visibility="{Binding IsCutToClipboard, Converter={StaticResource BooleanToVisibility}}">
                                                <Border.Effect><DropShadowEffect Color="#50000000" BlurRadius="3" ShadowDepth="1" Opacity="0.45" /></Border.Effect>
                                                <Viewbox Width="14" Height="14">
                                                    <Path Data="M4,2.5 A2,2 0 1 0 4,6.5 A2,2 0 1 0 4,2.5 M4,9.5 A2,2 0 1 0 4,13.5 A2,2 0 1 0 4,9.5 M5.7,5.4 L13,11.8 M5.7,10.6 L13,4.2"
                                                          Stroke="#0F6CBD" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                       Foreground="{Binding DataContext.PrimaryForeground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="12" Effect="{Binding DataContext.ContentShadow, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="MaxHeight" Value="32" />
                                                        <Setter Property="Width" Value="72" />
                                                        <Setter Property="Margin" Value="0,50,0,0" />
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                        <Setter Property="VerticalAlignment" Value="Top" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCutToClipboard}" Value="True">
                                                                <Setter Property="Opacity" Value="0.5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="List">
                                                                <Setter Property="TextAlignment" Value="Left" />
                                                                <Setter Property="TextWrapping" Value="NoWrap" />
                                                                <Setter Property="MaxHeight" Value="36" />
                                                                <Setter Property="Width" Value="Auto" />
                                                                <Setter Property="Margin" Value="46,0,0,0" />
                                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ShowFullName}" Value="True">
                                                                <Setter Property="MaxHeight" Value="96" />
                                                                <Setter Property="TextTrimming" Value="None" />
                                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        <TextBox x:Name="RenameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BooleanToVisibility}}"
                                                 PreviewKeyDown="RenameBox_PreviewKeyDown"
                                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource InlineFileNameEditorStyle}">
                                                    <Setter Property="Width" Value="72" />
                                                    <Setter Property="MaxHeight" Value="42" />
                                                    <Setter Property="Margin" Value="0,50,0,0" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                    <Setter Property="TextAlignment" Value="Center" />
                                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="List">
                                                            <Setter Property="Width" Value="Auto" />
                                                            <Setter Property="MaxWidth" Value="240" />
                                                            <Setter Property="MaxHeight" Value="28" />
                                                            <Setter Property="Margin" Value="46,0,4,0" />
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="TextAlignment" Value="Left" />
                                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="把桌面文件拖到这里" Foreground="{Binding SecondaryForeground}"
                               Effect="{Binding ContentShadow}"
                               FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Canvas IsHitTestVisible="False" Panel.ZIndex="10">
                        <Border x:Name="SelectionMarquee" Visibility="Collapsed"
                                Background="#284A90E2" BorderBrush="#C06EA8F1"
                                BorderThickness="1" CornerRadius="2" />
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <Thumb x:Name="ResizeHandle" Grid.RowSpan="3" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Panel.ZIndex="10" Background="Transparent" Cursor="SizeNWSE" Opacity="0.5" DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}">
                            <Viewbox Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3.5,3.5">
                                <Path Data="M3,15 L15,3 M8,16 L16,8" Stroke="{Binding PrimaryForeground}"
                                      Effect="{Binding ContentShadow}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border x:Name="MergeDropOverlay" Grid.RowSpan="3" Panel.ZIndex="30"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    CornerRadius="7" BorderThickness="1.5" BorderBrush="{Binding ItemSelectedBorder}"
                    Background="Transparent" Opacity="0" IsHitTestVisible="False">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,3"
                        CornerRadius="6" Background="#E6222936">
                    <TextBlock Text="松开以合并" Foreground="White" FontSize="13" />
                </Border>
            </Border>
        </Grid>
    </Border>
</local:DesktopBoxWindow>

<Window x:Class="MiniC.Views.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniC 快捷面板"
        Width="326" Height="430"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#56FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#A8FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="#42FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#B8FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#EFFFFFFF" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#778698AA" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="1.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialButton" TargetType="RadioButton">
            <Setter Property="Width" Value="67" />
            <Setter Property="Height" Value="49" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="#B62F3948" />
            <Setter Property="Background" Value="#42FFFFFF" />
            <Setter Property="BorderBrush" Value="#48FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#B4FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#EFFFFFFF" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#778698AA" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="1.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="24" Background="#EAF8FAFE" BorderBrush="#E8FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#33415367" BlurRadius="28" ShadowDepth="8" Opacity="0.32" />
        </Border.Effect>
        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="12" Background="#F20F1117">
                    <Image Source="pack://application:,,,/icon.ico" Width="25" Height="25" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="MiniC" FontSize="16" FontWeight="Normal" Foreground="#E51D2430" />
                    <TextBlock Text="桌面收纳快捷面板" FontSize="11" Foreground="#99616B7A" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="收起面板" Click="ClosePanel_Click">
                    <Viewbox Width="14" Height="14">
                        <Path Data="M5,5 L19,19 M19,5 L5,19" Stroke="#B53E4958" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>
            </Grid>

            <Button Grid.Row="1" Height="46" Margin="0,16,0,14" BorderThickness="0"
                    Background="#EE202734" Foreground="White" Cursor="Hand" Click="CreateGroup_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionShell" Background="{TemplateBinding Background}" CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="18" Height="18" Margin="0,0,9,0">
                                    <Path Data="M4,12 L20,12 M12,4 L12,20" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Text="新建收纳盒" FontSize="14" FontWeight="Normal" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionShell" Property="Background" Value="#FF303949" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Grid Grid.Row="2">
                <TextBlock Text="统一收纳盒样式" FontSize="12" FontWeight="Normal" Foreground="#D02A3340"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" ToolTip="显示或隐藏所有收纳盒"
                        Click="ToggleBoxes_Click">
                    <Viewbox Width="17" Height="17">
                        <Path Data="M2,12 C5,7 8,5 12,5 C16,5 19,7 22,12 C19,17 16,19 12,19 C8,19 5,17 2,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12"
                              Stroke="#B53E4958" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round" />
                    </Viewbox>
                </Button>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,7,0,0">
                <TextBlock Text="主题颜色" FontSize="11" Foreground="#8E687383" Margin="0,0,0,7" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeWhite" GroupName="Themes" Style="{StaticResource ThemeButton}" Tag="White" ToolTip="珍珠白" Click="Theme_Click"><Ellipse Width="22" Height="22" Fill="#FFF7FAFF" Stroke="#BFD8DFE9" StrokeThickness="1" /></RadioButton>
                    <RadioButton x:Name="ThemeBlue" GroupName="Themes" Style="{StaticResource ThemeButton}" Tag="Blue" ToolTip="冰川蓝" Click="Theme_Click"><Ellipse Width="22" Height="22" Fill="#FFDDEBFF" Stroke="#9AB7D2F5" StrokeThickness="1" /></RadioButton>
                    <RadioButton x:Name="ThemeMint" GroupName="Themes" Style="{StaticResource ThemeButton}" Tag="Mint" ToolTip="薄荷绿" Click="Theme_Click"><Ellipse Width="22" Height="22" Fill="#FFDCF7EE" Stroke="#91ABD9C8" StrokeThickness="1" /></RadioButton>
                    <RadioButton x:Name="ThemePurple" GroupName="Themes" Style="{StaticResource ThemeButton}" Tag="Purple" ToolTip="淡雅紫" Click="Theme_Click"><Ellipse Width="22" Height="22" Fill="#FFEAE0FF" Stroke="#9BC7B6E9" StrokeThickness="1" /></RadioButton>
                    <RadioButton x:Name="ThemeAmber" GroupName="Themes" Style="{StaticResource ThemeButton}" Tag="Amber" ToolTip="暖阳橙" Click="Theme_Click"><Ellipse Width="22" Height="22" Fill="#FFFFF0D2" Stroke="#A8E6C28C" StrokeThickness="1" /></RadioButton>
                    <RadioButton x:Name="ThemeGraphite" GroupName="Themes" Style="{StaticResource ThemeButton}" Tag="Graphite" ToolTip="石墨黑" Click="Theme_Click" Margin="0"><Ellipse Width="22" Height="22" Fill="#FF282C38" Stroke="#8A6D7484" StrokeThickness="1" /></RadioButton>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="玻璃材质" FontSize="11" Foreground="#8E687383" Margin="0,0,0,7" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="MaterialClear" GroupName="Materials" Style="{StaticResource MaterialButton}" Tag="Clear" Click="Material_Click">
                        <StackPanel HorizontalAlignment="Center"><Viewbox Width="16" Height="16"><Path Data="M3,4 L21,4 L21,20 L3,20 Z M6,8 L18,8" Stroke="#A9475668" StrokeThickness="1.6" Fill="Transparent" /></Viewbox><TextBlock Text="清透" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MaterialFrosted" GroupName="Materials" Style="{StaticResource MaterialButton}" Tag="Frosted" Click="Material_Click">
                        <StackPanel HorizontalAlignment="Center"><Viewbox Width="16" Height="16"><Path Data="M5,6 L5.1,6 M12,6 L12.1,6 M19,6 L19.1,6 M8.5,12 L8.6,12 M15.5,12 L15.6,12 M5,18 L5.1,18 M12,18 L12.1,18 M19,18 L19.1,18" Stroke="#A9475668" StrokeThickness="2.6" StrokeStartLineCap="Round" /></Viewbox><TextBlock Text="磨砂" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MaterialCrystal" GroupName="Materials" Style="{StaticResource MaterialButton}" Tag="Crystal" Click="Material_Click">
                        <StackPanel HorizontalAlignment="Center"><Viewbox Width="16" Height="16"><Path Data="M12,2 L21,10 L12,22 L3,10 Z M3,10 L21,10 M8,3.5 L6.5,10 L12,22 L17.5,10 L16,3.5" Stroke="#A9475668" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="晶透" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MaterialSatin" GroupName="Materials" Style="{StaticResource MaterialButton}" Tag="Satin" Click="Material_Click" Margin="0">
                        <StackPanel HorizontalAlignment="Center"><Viewbox Width="16" Height="16"><Path Data="M3,7 C7,3 10,11 14,7 C17,4 19,5 21,7 M3,13 C7,9 10,17 14,13 C17,10 19,11 21,13 M3,19 C7,15 10,23 14,19 C17,16 19,17 21,19" Stroke="#A9475668" StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Round" /></Viewbox><TextBlock Text="柔光" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,13,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="透明度" FontSize="11" Foreground="#8E687383" />
                <TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" FontSize="11" Foreground="#A34A5667" />
                <Slider x:Name="OpacitySlider" Grid.Row="1" Minimum="0.22" Maximum="0.92" Value="0.62"
                        TickFrequency="0.02" IsSnapToTickEnabled="True" Margin="0,6,0,0" ValueChanged="OpacitySlider_ValueChanged" />
            </Grid>

            <TextBlock Grid.Row="8" Text="调整后会同步应用到现在和之后新建的收纳盒" FontSize="10.5"
                       Foreground="#74687383" VerticalAlignment="Bottom" Margin="0,10,0,0" />

        </Grid>
    </Border>
</Window>

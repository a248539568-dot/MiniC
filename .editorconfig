root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml}]
indent_style = space
indent_size = 4

[*.cs]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

[*.{yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.cs]

# Keep interface-oriented service APIs and WPF instance handlers stable. These
# performance/style suggestions remain available in explicit analyzer audits,
# but do not block correctness-focused release builds.
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1826.severity = suggestion
dotnet_diagnostic.CA1854.severity = suggestion
dotnet_diagnostic.CA1859.severity = none
